
<!DOCTYPE html>
<html>
<head><title>Agent Form</title></head>
<body>
    <div>
    <%-include('partials/header.ejs')%>
    </div>
    <a href="Agents">
        <p>View All Agents</p>
    </a>

    <a href="adBanners">
        <p>View All Campaigns</p>
    </a>

    <br><br>

    <h1>Create Your Agent Account</h1>
    <form action="./" method="POST">
        <label for="userName">Agent Name:</label>
        <input type="text" name="name" required placeholder="Your Name"><br><br>
        <label for="userEmail">Socials Account:</label>
        <input type="text" name="contact" required placeholder="@Socials"><br><br>
        <input type="hidden" name="type" value="agent">
        <button type="submit">Sign Me Up</button>
    </form>
    <%-include('partials/footer.ejs')%>


</body>
</html>

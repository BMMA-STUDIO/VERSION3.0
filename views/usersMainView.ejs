<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%-title%></title>
    <style>
        /* 🌟 NEW: Container for the Grid/Flex Layout 🌟 */
        .group-grid {
            display: flex; /* Activate flex layout */
            flex-wrap: wrap; /* Allow items to wrap to the next line if necessary */
            justify-content: flex-start; /* Start items from the left */
            gap: 15px; /* Adds space between the cards */
            padding: 10px; /* Optional: padding around the entire grid */
        }
        
        .group-card {
            border: 1px solid #ccc; 
            padding: 15px;
            margin-bottom: 0; /* Removed margin-bottom since gap handles spacing */
            border-radius: 8px;
            /* 🌟 CRITICAL CHANGE: Use flex-grow and flex-basis 🌟 */
            flex-grow: 1; /* Allows card to grow and fill available horizontal space */
            flex-basis: 280px; /* Suggests a minimum width before wrapping/growing */
            max-width: 400px; /* Keeps the max width limit */
        }
        
        .group-card a {
            display: inline-block;
            margin-top: 10px;
            color: #007bff;
        }
    </style>
</head>
<body>
    <h1>Explore</h1>
    
    <div class="group-grid">
        <% groups.forEach(function(groupcards) { %>
            <div class="group-card">
                <h3><%= groupcards.name %></h3>
                <p><%= groupcards.description %></p>
                <a href="<%= groupcards.signupLink %>">Sign Up Now</a>
            </div>
        <% }); %>
    </div>
    <%-include('partials/footer.ejs')%>
</body>
</html>